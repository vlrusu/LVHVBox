# Optional HV-only PostgreSQL output for graphite-pusher.
# Install as /etc/mu2e-tracker-lvhv-tools/graphite-pusher-postgres.env
# No password belongs in this file. Configure a protected libpq password file.
MU2E_POSTGRES_ENABLED=1
MU2E_POSTGRES_REGISTER_CHANNELS=0
PGHOST=mu2e-dcs-01
PGPORT=5434
PGDATABASE=dcs_archive
PGUSER=dcs_writer
PGPASSFILE=/etc/mu2e-tracker-lvhv-tools/postgres.pgpass
