# Alarm thresholds/timing: LVHVBox/config/alarm-policy.json (legacy numeric variables are ignored).
NETWORK_WATCH_LOG_PATH=/var/log/mu2e-tracker-network-watch/network-watch.log
NETWORK_WATCH_LOCAL_HOSTNAME=
NETWORK_WATCH_MASTER_ENDPOINTS=mu2e-trk-psu13.fnal.gov:12000
NETWORK_WATCH_GATEWAY_ENDPOINTS=mu2egateway01.fnal.gov:22,mu2egateway02.fnal.gov:22
NETWORK_WATCH_MASTER_HOSTS=mu2e-trk-psu13.fnal.gov
NETWORK_WATCH_REMOTE_PORT=12000
NETWORK_WATCH_LVHV_HOST=127.0.0.1
NETWORK_WATCH_LVHV_PORT=12000
NETWORK_WATCH_LVHV_COMMANDS_PATH=/etc/mu2e-tracker-lvhv-tools/commands.h
NETWORK_WATCH_LVHV_POWEROFF_CHANNEL=6
