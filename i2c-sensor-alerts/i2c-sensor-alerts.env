# Alarm thresholds/timing: LVHVBox/config/alarm-policy.json (legacy numeric variables are ignored).
I2C_SENSOR_ALERTS_SENSOR_URL=http://127.0.0.1:12003/health
I2C_SENSOR_ALERTS_LOG_PATH=/var/log/mu2e-tracker-i2c-sensor-tools/i2c-sensor-alerts.log
I2C_SENSOR_ALERTS_PUSHOVER_USER_KEY=
I2C_SENSOR_ALERTS_PUSHOVER_API_TOKEN=
I2C_SENSOR_ALERTS_LVHV_HOST_PREFIX=mu2e-trk-psu
I2C_SENSOR_ALERTS_LVHV_HOST_SUFFIX=.fnal.gov
I2C_SENSOR_ALERTS_LVHV_HOST_START=0
I2C_SENSOR_ALERTS_LVHV_HOST_STOP=17
I2C_SENSOR_ALERTS_LVHV_PORT=12000
I2C_SENSOR_ALERTS_LVHV_COMMANDS_PATH=/etc/mu2e-tracker-lvhv-tools/commands.h
I2C_SENSOR_ALERTS_LVHV_POWEROFF_CHANNEL=6
